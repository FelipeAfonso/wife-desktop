#!/bin/sh
# Apply this repo's configs to the machine. /etc files and services are not
# touched — see README for those steps.
set -eu

dirs="ghostty dunst hypr nvim opencode rofi tmux waybar wallust xkb zsh starship lazygit btop MangoHud git gtk-3.0 gtk-4.0"
files="mimeapps.list user-dirs.dirs"

for d in $dirs; do
  cp -rf "./$d" "$HOME/.config/"
done

for f in $files; do
  cp -f "./$f" "$HOME/.config/"
done

cp -f ./zsh/.zshenv "$HOME/.zshenv"

mkdir -p "$HOME/.local/bin"
cp -f ./bin/* "$HOME/.local/bin/"
for s in ./bin/*; do
  chmod +x "$HOME/.local/bin/$(basename "$s")"
done

mkdir -p "$HOME/.config/systemd/user"
# -r: unit drop-in dirs (*.service.d) ship alongside the flat unit files
cp -rf ./systemd/user/* "$HOME/.config/systemd/user/"

# Global agent prompts, one generated file per CLI: the per-CLI section,
# the shared model table (models.md), then the miskatonic operating notes.
# The first two are kept in sync by hand with personal-server's
# home/felipe/agents/*.md and personal-laptop's agents/*.md. Edit agents/*.md and re-run; never
# edit the generated files in place.
mkdir -p "$HOME/.claude" "$HOME/.codex" "$HOME/.config/opencode"
{ cat ./agents/claude-global.md; echo; cat ./agents/models.md; echo; cat ./agents/miskatonic-agents.md; } > "$HOME/.claude/CLAUDE.md"
{ cat ./agents/codex-global.md; echo; cat ./agents/models.md; echo; cat ./agents/miskatonic-agents.md; } > "$HOME/.codex/AGENTS.md"
{ cat ./agents/opencode-global.md; echo; cat ./agents/models.md; echo; cat ./agents/miskatonic-agents.md; } > "$HOME/.config/opencode/AGENTS.md"

# Skills vendored in the repo so a fresh install has them. Claude Code reads
# ~/.claude/skills; codex and opencode both read ~/.agents/skills. Other
# entries in those dirs (installed with `npx skills add ...`) are left alone.
mkdir -p "$HOME/.claude/skills" "$HOME/.agents/skills"
cp -rf ./agents/skills/plan-html-workflow "$HOME/.claude/skills/"
cp -rf ./agents/skills/unslop "$HOME/.claude/skills/"
cp -rf ./agents/skills/unslop "$HOME/.agents/skills/"

# Hook scripts referenced by ~/.claude/settings.json. That file stays mutable
# (Claude Code writes to it at runtime), so the hooks block in it is set by
# hand — see README; only the scripts are repo-managed.
mkdir -p "$HOME/.claude/hooks"
cp -f ./agents/hooks/* "$HOME/.claude/hooks/"
for s in ./agents/hooks/*; do
  chmod +x "$HOME/.claude/hooks/$(basename "$s")"
done
