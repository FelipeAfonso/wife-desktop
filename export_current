#!/bin/sh
# Apply this repo's configs to the machine. /etc files and services are not
# touched — see README for those steps.
set -eu

dirs="ghostty dunst hypr nvim opencode rofi tmux waybar wallust xkb zsh starship lazygit btop MangoHud git gtk-3.0 gtk-4.0"
files="mimeapps.list user-dirs.dirs"

for d in $dirs; do
  cp -rf "./$d" "$HOME/.config/"
done

for f in $files; do
  cp -f "./$f" "$HOME/.config/"
done

cp -f ./zsh/.zshenv "$HOME/.zshenv"

mkdir -p "$HOME/.local/bin"
cp -f ./bin/* "$HOME/.local/bin/"
for s in ./bin/*; do
  chmod +x "$HOME/.local/bin/$(basename "$s")"
done

mkdir -p "$HOME/.config/systemd/user"
# -r: unit drop-in dirs (*.service.d) ship alongside the flat unit files
cp -rf ./systemd/user/* "$HOME/.config/systemd/user/"
