#!/bin/sh
# Apply this repo's configs to the machine. /etc files and services are not
# touched; see README for those steps. Copy-based: every file stays a file.
set -eu

dirs="hypr noctalia uwsm ghostty rofi zsh btop MangoHud gtk-3.0 gtk-4.0 qt6ct xsettingsd"
files="mimeapps.list user-dirs.dirs kdeglobals"

for d in $dirs; do
  cp -rf "./$d" "$HOME/.config/"
done

for f in $files; do
  cp -f "./$f" "$HOME/.config/"
done

cp -f ./zsh/.zshenv "$HOME/.zshenv"
chmod +x "$HOME"/.config/hypr/scripts/*

# CachyOS autostarts its welcome app for every new user. Not on her desktop.
rm -f "$HOME/.config/autostart/cachyos-hello.desktop"

mkdir -p "$HOME/.local/bin"
cp -f ./bin/* "$HOME/.local/bin/"
for s in ./bin/*; do
  chmod +x "$HOME/.local/bin/$(basename "$s")"
done

mkdir -p "$HOME/.config/systemd/user"
# -r: unit drop-in dirs (*.service.d) ship alongside the flat unit files
cp -rf ./systemd/user/* "$HOME/.config/systemd/user/"

# Global agent prompts, one generated file per CLI: the per-CLI section,
# the shared model table (models.md), then this machine's operating notes.
# The first two are copies of personal-desktop's agents/*.md; sync by hand.
# Edit agents/*.md and re-run; never edit the generated files in place.
mkdir -p "$HOME/.claude" "$HOME/.codex" "$HOME/.config/opencode"
{ cat ./agents/claude-global.md; echo; cat ./agents/models.md; echo; cat ./agents/ulthar-agents.md; } > "$HOME/.claude/CLAUDE.md"
{ cat ./agents/codex-global.md; echo; cat ./agents/models.md; echo; cat ./agents/ulthar-agents.md; } > "$HOME/.codex/AGENTS.md"
{ cat ./agents/opencode-global.md; echo; cat ./agents/models.md; echo; cat ./agents/ulthar-agents.md; } > "$HOME/.config/opencode/AGENTS.md"

# Skills vendored in the repo so a fresh install has them. Claude Code reads
# ~/.claude/skills; codex and opencode both read ~/.agents/skills.
mkdir -p "$HOME/.claude/skills" "$HOME/.agents/skills"
cp -rf ./agents/skills/plan-html-workflow "$HOME/.claude/skills/"
cp -rf ./agents/skills/unslop "$HOME/.claude/skills/"
cp -rf ./agents/skills/unslop "$HOME/.agents/skills/"

# Hook scripts referenced by ~/.claude/settings.json. That file stays mutable
# (Claude Code writes to it at runtime), so the hooks block in it is set by
# hand; see README. Only the scripts are repo-managed.
mkdir -p "$HOME/.claude/hooks"
cp -f ./agents/hooks/* "$HOME/.claude/hooks/"
for s in ./agents/hooks/*; do
  chmod +x "$HOME/.claude/hooks/$(basename "$s")"
done

# Pick up the new config in the running session, if there is one.
if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  hyprctl reload >/dev/null && echo "hyprland reloaded"
  noctalia msg config-reload >/dev/null 2>&1 && echo "noctalia reloaded" || true
else
  echo "not inside a Hyprland session: log out and back in, or run 'hyprctl reload' from one"
fi
