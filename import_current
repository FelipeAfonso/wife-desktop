#!/bin/sh
# Pull the live state of ulthar into this repo. Run from the repo root.
set -eu

dirs="ghostty dunst hypr rofi waybar wallust zsh btop MangoHud gtk-3.0 gtk-4.0"
files="mimeapps.list user-dirs.dirs"
scripts="t3-rebuild-node-pty.sh"

for d in $dirs; do
  rm -rf "./$d"
  cp -r "$HOME/.config/$d" ./
done

for f in $files; do
  cp -f "$HOME/.config/$f" ./
done

# Strip machine state that must never be committed
rm -f ./zsh/.zsh_history ./zsh/.zcompdump* ./dunst/notification.log
rm -f ./gtk-3.0/bookmarks ./hypr/*.mkv

mkdir -p ./bin
for s in $scripts; do
  cp -f "$HOME/.local/bin/$s" ./bin/
done

# Custom user units only; enable-state symlinks (*.wants) stay out
mkdir -p ./systemd/user
cp -f "$HOME"/.config/systemd/user/*.service ./systemd/user/
# Unit drop-in dirs (*.service.d) too; t3code relies on them for node-pty
# rebuilds and the provider PATH
for d in "$HOME"/.config/systemd/user/*.service.d; do
  [ -d "$d" ] || continue
  rm -rf "./systemd/user/$(basename "$d")"
  cp -r "$d" ./systemd/user/
done

# Package + service reality
pacman -Qqen > pkglist-native.txt
pacman -Qqem > pkglist-aur.txt
{
  echo "# Enabled units on ulthar. Regenerated by ./import_current, do not hand-edit."
  echo "# Apply on a fresh install: systemctl enable <unit> / systemctl --user enable <unit>"
  echo
  echo "# system"
  systemctl list-unit-files --state=enabled --no-legend | awk '{print $1}' | grep -v '@'
  echo
  echo "# user"
  systemctl --user list-unit-files --state=enabled --no-legend | awk '{print $1}'
} > services.txt
