{
  "layer": "top",
  "height": 36,
  "spacing": 8,
  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "tray",
    "mpris",
    "pulseaudio/slider",
    "pulseaudio",
    "cpu",
    "memory",
    "clock",
  ],
  // Start button. Clicking it is the same as pressing Super.
  "custom/launcher": {
    "format": "  ",
    "on-click": "pkill rofi || rofi -show drun",
    "tooltip": false,
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "on-click": "activate",
    "format": "{name} {icon}",
    "format-icons": {
      "active": " ",
      "default": " ",
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
    },
  },
  "tray": {
    "icon-size": 28,
    "spacing": 10,
    "show-passive-items": true,
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },
  "mpris": {
    "format": "{status_icon}  {artist} - {title}",
    "format-paused": "{status_icon}  <i>{artist} - {title}</i>",
    "format-stopped": "",
    "status-icons": {
      "paused": "",
      "playing": "",
      "stopped": "",
    },
    "max-length": 50,
  },
  "clock": {
    "timezone": "America/Sao_Paulo",
    "tooltip-format": "<big>{:%Y-%m-%d %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M %d/%m}",
    "interval": 10,
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": false,
  },
  "memory": {
    "format": "{}% ",
  },
  "hyprland/window": {
    "separate-outputs": true,
  },
  "pulseaudio": {
    "format": "{volume}%  {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-bluetooth-muted": " {icon}",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
  },
}
